# Токен Telegram-бота, полученный у @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API-ключ Yandex Cloud для доступа к YandexGPT.
# Создаётся в консоли Yandex Cloud: https://yandex.cloud/ru/docs/iam/concepts/authorization/api-key
YANDEX_API_KEY=your_yandex_api_key_here

# OpenAI-совместимый endpoint YandexGPT.
# Можно оставить как есть, если используете облачный YandexGPT.
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1

# Идентификатор модели. Доступные варианты: yandexgpt-lite, yandexgpt, yandexgpt-pro и др.
YANDEX_MODEL=yandexgpt-lite

# Температура сэмплирования (0.0 — более детерминированные ответы, 1.0 — более креативные)
YANDEX_TEMPERATURE=0.1

# Максимальное количество токенов в ответе
YANDEX_MAX_TOKENS=1500

# Количество ближайших чанков, передаваемых в контекст LLM
# K_RETRIEVER=5
